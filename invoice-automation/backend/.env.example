# Flask settings
FLASK_DEBUG=false
PORT=5000

Database
MONGO_URI=mongodb://localhost:27017/
DB_NAME=invoice_db

# Security (REQUIRED in production - generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=

# Optional: AI Configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic  # Options: 'anthropic' or 'openai'

# Optional: Email Notifications configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
